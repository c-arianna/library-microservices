{
  "vhosts": [
    { "name": "/" }
  ],

  "exchanges": [
    {
      "name": "events.exchange",
      "vhost": "/",
      "type": "topic",
      "durable": true
    }
  ],

  "queues": [
    {
      "name": "book-service.queue",
      "vhost": "/",
      "durable": true
    },
    {
      "name": "loan-service.queue",
      "vhost": "/",
      "durable": true
    },
    {
      "name": "user-service.queue",
      "vhost": "/",
      "durable": true
    }
  ],

  "bindings": [

    {
      "source": "events.exchange",
