      "destination_type": "queue",
      "routing_key": "loan.requested"
    },
    {
      "source": "events.exchange",
      "vhost": "/",
      "destination": "book-service.queue",
      "destination_type": "queue",
      "routing_key": "loan.confirm.requested"
    },
    {
      "source": "events.exchange",
      "vhost": "/",
      "destination": "book-service.queue",
      "destination_type": "queue",
      "routing_key": "loan.canceled"
    },
    {
      "source": "events.exchange",
      "vhost": "/",
      "destination": "book-service.queue",
      "destination_type": "queue",
      "routing_key": "loan.returned"
    },
    {
      "source": "events.exchange",
      "vhost": "/",
      "destination": "loan-service.queue",
