{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "LoanFailedEventV1",
	"allOf": [
		{
			"$ref": "../../../common/event-envelope.schema.json#/$defs/eventEnvelope"
		},
		{
			"type": "object",
			"properties": {
				"eventType": {
					"const": "LOAN_FAILED"
				},
				"producer": {
					"const": "loan-service"
				},
				"aggregateType": {
					"const": "LOAN"
				},
				"payload": {
					"properties": {
						"loanId": {
							"$ref": "../../../common/common-types.schema.json#/$defs/nonBlankString"
						},
						"reason": {
							"type": "string"
						}
					},
					"required": [
						"loanId",
						"reason"
					]
				}
			},
			"required": [
				"eventType",
				"producer",
				"aggregateType",
				"payload"
			]
		}
	],
	"unevaluatedProperties": false
}