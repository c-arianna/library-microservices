{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "LoanRequestedEventV1",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"eventId": {
			"type": "string",
			"format": "uuid"
		},
		"eventType": {
			"type": "string",
			"const": "LOAN_REQUESTED"
		},
		"producer": {
			"type": "string",
			"const": "loan-service"
		},
		"aggregateId": {
			"type": "string"
		},
		"occurredAt": {
			"type": "string",
			"format": "date-time"
		},
		"schemaVersion": {
			"type": "integer",
			"const": 1
		},
		"payload": {
			"properties": {
				"loanId": {
					"type": "string"
				},
				"isbn": {
					"type": "string"
				},
				"userId": {
					"type": "string"
				},
				"start": {
					"type": "string",
					"format": "date"
				},
				"end": {
					"type": "string",
					"format": "date"
				}
			},
			"required": [
				"loanId",
				"isbn",
				"userId",
				"start",
				"end"
			]
		}
	},
	"required": [
		"eventId",
		"eventType",
		"producer",
		"aggregateId",
		"occurredAt",
		"schemaVersion",
		"payload"
	]
}