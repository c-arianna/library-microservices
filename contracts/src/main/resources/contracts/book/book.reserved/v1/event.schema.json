{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "BookReservedEventV1",
	"allOf": [
		{
			"$ref": "../../../common/event-envelope.schema.json#/$defs/eventEnvelope"
		},
		{
			"type": "object",
			"properties": {
				"eventType": {
					"const": "BOOK_RESERVED"
				},
				"producer": {
					"const": "book-service"
				},
				"aggregateType": {
					"const": "BOOK"
				},
				"payload": {
					"properties": {
						"isbn": {
							"$ref": "../../../common/common-types.schema.json#/$defs/nonBlankString"
						},
						"loanId": {
							"$ref": "../../../common/common-types.schema.json#/$defs/nonBlankString"
						},
						"userId": {
							"$ref": "../../../common/common-types.schema.json#/$defs/nonBlankString"
						}
					},
					"required": [
						"isbn",
						"loanId",
						"userId"
					]
				}
			},
			"required": [
				"eventType",
				"producer",
				"aggregateType",
				"payload"
			]
		}
	],
	"unevaluatedProperties": false
}