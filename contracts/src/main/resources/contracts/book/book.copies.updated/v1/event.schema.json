{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "BookCopiesUpdateEventV1",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"eventId": {
			"type": "string",
			"format": "uuid"
		},
		"eventType": {
			"type": "string",
			"const": "BOOK_COPIES_UPDATED"
		},
		"producer": {
			"type": "string",
			"const": "book-service"
		},
		"aggregateId": {
			"type": "string"
		},
		"aggregateType": {
			"type": "string",
			"const": "BOOK"
		},
		"eventVersion": {
			"type": "integer"
		},
		"occurredAt": {
			"type": "string",
			"format": "date-time"
		},
		"schemaVersion": {
			"type": "integer",
			"const": 1
		},
		"payload": {
			"properties": {
				"isbn": {
					"type": "string"
				},
				"quantity": {
					"type": "integer"
				}
			},
			"required": [
				"isbn",
				"quantity"
			]
		}
	},
	"required": [
		"eventId",
		"eventType",
		"producer",
		"aggregateId",
		"aggregateType",
		"eventVersion",
		"occurredAt",
		"schemaVersion",
		"payload"
	]
}