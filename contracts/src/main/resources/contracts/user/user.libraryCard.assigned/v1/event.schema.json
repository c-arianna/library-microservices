				},
				"aggregateType": {
					"const": "USER"
				},
				"payload": {
					"properties": {
						"userId": {
							"$ref": "../../../common/common-types.schema.json#/$defs/nonBlankString"
						},
						"cardNumber": {
							"$ref": "../../../common/common-types.schema.json#/$defs/nonBlankString"
						}
					},
					"required": [
						"userId",
						"cardNumber"
					]
				}
			},
			"required": [
				"eventType",
				"producer",
				"aggregateType",
				"payload"
			]
		}
	],
	"unevaluatedProperties": false
